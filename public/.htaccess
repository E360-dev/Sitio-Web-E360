# Configuración de Apache para e360.pro
# Un enlace inexistente conserva la pantalla React, pero responde HTTP 404.
ErrorDocument 404 /_notfound/index.html
#
# Este archivo se despliega con el sitio (Vite copia public/ a dist/).
# Antes vivía únicamente en el servidor, sin copia ni historial.

# Module workers require a JavaScript MIME type. Keep .mjs support for older
# cached frontend bundles as well as the new compiled .js PDF worker.
<IfModule mod_mime.c>
  AddType application/javascript .js .mjs
</IfModule>

# ---------------------------------------------------------------------------
# Redirección de www al dominio principal
#
# https://www.e360.pro y https://e360.pro servían el mismo contenido con
# código 200 y sin redirección, así que para Google eran dos sitios distintos
# con contenido idéntico y la autoridad se repartía entre ambos. Va antes que
# las reglas de la SPA para que redirija también los archivos existentes.
# ---------------------------------------------------------------------------
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  RewriteCond %{HTTP_HOST} ^www\.e360\.pro$ [NC]
  RewriteRule ^(.*)$ https://e360.pro/$1 [R=301,L]

  # La shell privada arranca React sin contenido ni canónica de la portada.
  RewriteRule ^(?:admin|cliente|documento|login|registro|pendiente|crear-contrasena)(?:/.*)?$ /_private/index.html [L]

  # -------------------------------------------------------------------------
  # Páginas prerenderizadas
  #
  # El build genera un index.html por ruta (/comunica/mi-articulo/index.html).
  # Sin esta regla, Apache detectaría el directorio y mod_dir redirigiría a
  # /comunica/mi-articulo/ con barra final — una URL distinta de la que declara
  # la etiqueta canónica. Aquí se sirve el archivo directamente, sin redirigir.
  # -------------------------------------------------------------------------
  # DirectorySlash Off es imprescindible: sin él, mod_dir redirige /servicios a
  # /servicios/ ANTES de que actúe la regla siguiente. Esas URLs llevan
  # indexadas sin barra desde la Fase 1 y la etiqueta canónica las declara así.
  DirectorySlash Off

  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME}/index.html -f
  RewriteRule ^(.+?)/?$ /$1/index.html [L]

  # -------------------------------------------------------------------------
  # Archivos existentes y errores para rutas desconocidas.
  # Las rutas conocidas se sirven por las reglas anteriores.
  # -------------------------------------------------------------------------

  # Si el archivo o carpeta existe, servirlo normalmente
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Las rutas públicas válidas ya tienen HTML; las privadas se resuelven arriba.
  RewriteRule ^ - [R=404,L]
</IfModule>

# ---------------------------------------------------------------------------
# Caché
#
# Es lo que elimina el purgado manual después de cada despliegue.
# ---------------------------------------------------------------------------
<IfModule mod_headers.c>
  # THE_REQUEST conserva la ruta original tras las reescrituras internas.
  Header always set X-Robots-Tag "noindex, nofollow" "expr=%{REQUEST_STATUS} == 404 || %{THE_REQUEST} =~ m#\s/+(?:admin|cliente|documento|login|registro|pendiente|crear-contrasena|_private|_notfound)(?:[/\s?])#"

  # El HTML se revalida siempre: es el único archivo que puede quedar obsoleto,
  # porque es quien apunta a los assets con hash.
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>

  # Los assets llevan hash en el nombre: si cambia el contenido, cambia la URL.
  # Pueden cachearse indefinidamente sin riesgo de servir algo viejo.
  <FilesMatch "\.(m?js|css|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # Imágenes y video no llevan hash, así que un año sería arriesgado si se
  # reemplaza un archivo conservando el nombre. Treinta días es el equilibrio.
  <FilesMatch "\.(webp|png|jpe?g|svg|mp4|ico)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>

  # Deben poder actualizarse el mismo día en que se publican.
  <FilesMatch "^(robots\.txt|sitemap\.xml)$">
    Header set Cache-Control "public, max-age=3600"
  </FilesMatch>
</IfModule>
